# Memcached Environment Variables
# Copy this file to .env and update the values
#
# Memcached is a high-performance, distributed memory object caching system
# See: https://memcached.org/

# ============================================================================
# Image
# ============================================================================
MEMCACHED_TAG=1.6-alpine
# Memcached image tag. Pin a minor (e.g. 1.6.31-alpine) in production.

# ============================================================================
# Network
# ============================================================================
MEMCACHED_PORT=11211
# Host-side port mapping. Change if 11211 conflicts on the host.

MEMCACHED_CONTAINER_NAME=memcached

# ============================================================================
# Resources
# ============================================================================
MEMCACHED_MEMORY=64
# Memory limit in MB (typical: 64 / 128 / 256 / 512 / 1024).

MEMCACHED_MAX_CONNECTIONS=1024
# Maximum simultaneous client connections.

MEMCACHED_MAX_ITEM_SIZE=1m
# Maximum size of a single item. Accepts k/m/g suffix.
# Increasing this beyond 1m can hurt slab efficiency.

# ============================================================================
# SECURITY WARNINGS
# ============================================================================
# IMPORTANT: Before deploying to production:
#
# 1. Do NOT expose Memcached port to the public internet
# 2. Use it only within internal Docker network
# 3. Consider using SASL authentication for added security
# 4. Set appropriate memory limits
# 5. Monitor memory usage and eviction rates
# 6. Keep Memcached updated to latest version
#
# Documentation:
# https://github.com/memcached/memcached/wiki
# ============================================================================
