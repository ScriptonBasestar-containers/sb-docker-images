# MariaDB Environment Configuration
# Copy this file to .env and customize the values
#
# Covers two stacks in this project:
#   1. MariaDB server    → compose.yml         (make up / make down)
#   2. Backup tooling    → backup/*.dockerfile (make backup-rclone-build / restic-build)

# ============================================================================
# Project / Timezone
# ============================================================================
PROJECT_NAME=mariadb
TZ=UTC

# ============================================================================
# MariaDB Server (compose.yml)
# ============================================================================
MARIADB_TAG=11-noble
# Pin a minor in production (e.g. 11.4-noble).

MARIADB_CONTAINER_NAME=mariadb
MYSQL_PORT=3306

# Server credentials — change before exposing the service.
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=apppass

# ============================================================================
# Backup connection (used by backup/ scripts)
# ============================================================================
# Hostname the backup container resolves to reach MariaDB.
# In the default compose stack this is the container_name above.
MYSQL_HOST=mariadb

# Dedicated backup user (NOT root). Create with:
#   GRANT SELECT, RELOAD, LOCK TABLES, REPLICATION CLIENT, PROCESS ON *.*
#       TO 'backup_user'@'%' IDENTIFIED BY '...';
# When MYSQL_USER above already has these grants you can reuse it.
# (The backup scripts read MYSQL_USER / MYSQL_PASSWORD.)

# ============================================================================
# Backup Schedule
# ============================================================================
# Cron expression evaluated inside the backup container.
# Edit backup/backup_cron to apply changes (this var is informational).
BACKUP_CRON=0 2 * * *

BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=12

# ============================================================================
# Restic backend (backup/restic.dockerfile)
# ============================================================================
RESTIC_PASSWORD=change-me-strong-password
# Restic repository location. Examples:
#   Local:  /backup
#   SFTP:   sftp:user@host:/path
#   S3:     s3:s3.amazonaws.com/bucket-name/mariadb
#   B2:     b2:bucket-name:mariadb
RESTIC_REPOSITORY=/backup

# AWS credentials when RESTIC_REPOSITORY uses s3:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# B2 credentials when RESTIC_REPOSITORY uses b2:
# B2_ACCOUNT_ID=...
# B2_ACCOUNT_KEY=...

# ============================================================================
# Rclone backend (backup/rclone.dockerfile)
# ============================================================================
# Remote definition lives in rclone.conf — mount it into the backup container
# at /root/.config/rclone/rclone.conf or pass it via RCLONE_CONFIG.
RCLONE_REMOTE=myremote:backup/mariadb
RCLONE_BWLIMIT=0
# 0 = unlimited. Use "10M" for 10 MB/s, etc.

# ============================================================================
# SECURITY WARNINGS
# ============================================================================
# IMPORTANT before going to production:
#   1. Rotate all passwords (MYSQL_*, RESTIC_PASSWORD, cloud credentials)
#   2. Use a dedicated MYSQL backup user with the minimum grants listed above
#   3. Do NOT expose MYSQL_PORT to the public internet
#   4. Restic encrypts at rest — keep RESTIC_PASSWORD safe and recoverable
#   5. Regularly test restore: `mariabackup --copy-back --target-dir=<snapshot>`
#   6. Monitor /var/log/backup.log inside the backup container
# ============================================================================
