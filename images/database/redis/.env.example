# Redis Environment Variables
# Copy this file to .env and update the values
#
# Redis is an in-memory data structure store
# See: https://redis.io/

# ============================================================================
# Image
# ============================================================================
REDIS_TAG=7-alpine
# Redis image tag. Use a pinned minor (e.g. 7.4-alpine) in production.

# ============================================================================
# Network
# ============================================================================
REDIS_PORT=6379
# Host-side port mapping. Change if 6379 conflicts on the host.

REDIS_CONTAINER_NAME=redis

# ============================================================================
# Authentication
# ============================================================================
REDIS_PASSWORD=passw0rd
# WARNING: Change this password in production!
# Use a strong, unique password (16+ characters).
# Generate with: openssl rand -base64 32

# ============================================================================
# Persistence
# ============================================================================
REDIS_AOF=yes
# Append-only file persistence (yes/no). Required for durability.

# ============================================================================
# Memory
# ============================================================================
REDIS_MAX_MEMORY=256mb
# Hard memory cap. Tune for your workload (256mb / 1gb / 4gb).

REDIS_MAX_MEMORY_POLICY=allkeys-lru
# Eviction policy when maxmemory is hit. Options:
#   noeviction, allkeys-lru, allkeys-lfu, allkeys-random,
#   volatile-lru, volatile-lfu, volatile-random, volatile-ttl

# ============================================================================
# SECURITY WARNINGS
# ============================================================================
# IMPORTANT: Before deploying to production:
#
# 1. Change REDIS_PASSWORD to a strong random value
# 2. Consider not exposing Redis port to host (remove ports mapping)
# 3. Configure proper backup strategy (RDB snapshots + AOF)
# 4. Use TLS for encrypted connections if accessed cross-host
# 5. Review Redis security best practices
#
# Documentation:
# https://redis.io/topics/security
# ============================================================================
